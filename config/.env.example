"""
Phase 1.2: .env.example template
Template for environment variables
"""
# Security Configuration
SECRET_KEY=generate_this_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database Configuration - MongoDB
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DB_NAME=waf_db
MONGODB_MAX_POOL_SIZE=50

# Database Configuration - PostgreSQL (optional)
POSTGRESQL_URL=postgresql://user:password@localhost:5432/waf_db

# Redis Configuration (optional but recommended)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=production

# WAF Settings
DEFAULT_SNIFF_PORT=80
MAX_REQUEST_SIZE=10485760
BLOCK_MODE=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ML Model Paths
THREAT_MODEL_PATH=./waf/threat_engine/predictor.joblib
PT_MODEL_PATH=./waf/threat_engine/pt_predictor.joblib
